DATABASE_URL=postgresql+psycopg://mna_user:replace-me@localhost:5432/mna
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
NOTIFICATION_EMAIL=Laura@MotherNatureAcademy.com
SMTP_HOST=
# GoDaddy cPanel commonly uses port 465 with implicit TLS; use SMTP_STARTTLS=false for port 465.
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
# Set an admin username/password with: cd backend && .venv/bin/python -m app.admin_setup
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=
# For production HTTPS, change this to true. Local HTTP development needs false.
ADMIN_COOKIE_SECURE=false
