DATABASE_URL=postgresql+psycopg://mna_user:replace-me@localhost:5432/mna
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
NOTIFICATION_EMAIL=notification@MotherNatureAcademy.com
# GoDaddy cPanel secure outgoing mail server (port 465 uses implicit SSL/TLS).
SMTP_HOST=p3plzcpnl504528.prod.phx3.secureserver.net
SMTP_PORT=465
SMTP_USER=notification@mothernatureacademy.com
SMTP_FROM=notification@mothernatureacademy.com
# Put the mailbox password in the private backend/.env file; never commit it.
SMTP_PASSWORD=
SMTP_STARTTLS=false
# Generate once with: python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
# Keep this key private and stable; changing it makes saved admin SMTP passwords unreadable.
SMTP_CONFIG_ENCRYPTION_KEY=
# Separate, stable key for encrypted child health details in registration applications.
# Back this up securely; losing it makes those health details unreadable.
REGISTRATION_DATA_ENCRYPTION_KEY=
# Set an admin username/password with: cd backend && .venv/bin/python -m app.admin_setup
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=
# For production HTTPS, change this to true. Local HTTP development needs false.
ADMIN_COOKIE_SECURE=false
